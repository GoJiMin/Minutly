# Neon PostgreSQL connection string
DATABASE_URL=postgresql://...

# Azure Speech resource key and region
AZURE_SPEECH_SECRET_KEY=your-speech-key
AZURE_SPEECH_REGION=koreacentral
# Optional Azure Speech phrase hints. Leave empty to disable.
# Example: AZURE_SPEECH_PHRASES=메타,인스타그램,핫라인,틱톡,올리브영,계정,뷰티,패션
AZURE_SPEECH_PHRASES=

# Google AI Studio Gemini API key
GEMINI_API_KEY=your-gemini-api-key

# Single-user login
AUTH_LOGIN_ID=your-login-id
AUTH_PASSWORD=your-login-password

# JWT signing secrets
# Generate with: openssl rand -base64 32
AUTH_ACCESS_TOKEN_SECRET=your-access-token-secret
AUTH_REFRESH_TOKEN_SECRET=your-refresh-token-secret
